# Environment Variables Template for SURG Examples
# Copy this file to .env and fill in your values

# ================================
# CORE CONFIGURATION
# ================================

# Environment (development, staging, production)
SURG_ENV=development

# Log level (DEBUG, INFO, WARNING, ERROR)
SURG_LOG_LEVEL=INFO

# Enable debug mode (true/false)
SURG_DEBUG=true

# ================================
# GENAI CONFIGURATION
# ================================

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# Alternative GenAI Providers (uncomment to use)
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GOOGLE_AI_API_KEY=your-google-ai-key-here
# AZURE_OPENAI_ENDPOINT=your-azure-endpoint
# AZURE_OPENAI_API_KEY=your-azure-key

# ================================
# DATABASE CONFIGURATION
# ================================

# Primary Database
DATABASE_URL=postgresql://username:password@localhost:5432/surg_db
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30

# Test Database
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/surg_test_db

# ================================
# CACHE CONFIGURATION
# ================================

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_TTL=3600

# Memory Cache (fallback)
MEMORY_CACHE_SIZE=1000
MEMORY_CACHE_TTL=1800

# ================================
# API CONFIGURATION
# ================================

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Rate Limiting
API_RATE_LIMIT=1000
API_RATE_WINDOW=60

# Request Timeouts (seconds)
API_TIMEOUT=30
RECOMMENDATION_TIMEOUT=10
GENAI_TIMEOUT=15

# ================================
# MONITORING & OBSERVABILITY
# ================================

# Metrics Collection
METRICS_ENABLED=true
METRICS_EXPORT_INTERVAL=60

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=/var/log/surg/app.log

# Sentry Error Tracking (optional)
# SENTRY_DSN=your-sentry-dsn-here

# ================================
# EXTERNAL SERVICES
# ================================

# Vector Database (Pinecone, Weaviate, etc.)
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_ENVIRONMENT=your-pinecone-env
# WEAVIATE_URL=http://localhost:8080

# Email Service (for notifications)
# SENDGRID_API_KEY=your-sendgrid-key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-email-password

# ================================
# FEATURE FLAGS
# ================================

# Enable/Disable Features
FEATURE_GENAI_ENHANCED=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_BATCH_PROCESSING=true
FEATURE_A_B_TESTING=false

# Algorithm Preferences
DEFAULT_ALGORITHM=hybrid
ENABLE_COLLABORATIVE_FILTERING=true
ENABLE_CONTENT_BASED=true
ENABLE_DEEP_LEARNING=false

# ================================
# SECURITY CONFIGURATION
# ================================

# API Security
API_KEY_REQUIRED=false
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_EXPIRATION_HOURS=24

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE

# ================================
# PERFORMANCE TUNING
# ================================

# Recommendation Limits
MAX_RECOMMENDATIONS=100
DEFAULT_RECOMMENDATIONS=10
MIN_INTERACTIONS=3

# Processing Limits
MAX_BATCH_SIZE=1000
MAX_CONCURRENT_REQUESTS=100

# Cache Settings
CACHE_RECOMMENDATION_RESULTS=true
CACHE_SIMILARITY_RESULTS=true
CACHE_USER_PROFILES=true

# ================================
# DEVELOPMENT & TESTING
# ================================

# Development Mode Settings
DEV_AUTO_RELOAD=true
DEV_SAMPLE_DATA=true
DEV_MOCK_EXTERNAL_APIS=false

# Testing Configuration
TEST_PARALLELISM=4
TEST_TIMEOUT=300
TEST_GENERATE_REPORTS=true

# Jupyter Notebook Settings
JUPYTER_ENABLE=true
JUPYTER_PORT=8888

# ================================
# DATA CONFIGURATION
# ================================

# Data Sources
DATA_SOURCE=database  # database, file, api
DATA_REFRESH_INTERVAL=3600  # seconds

# File-based Data (if using file data source)
# DATA_USERS_FILE=data/users.csv
# DATA_ITEMS_FILE=data/items.csv  
# DATA_INTERACTIONS_FILE=data/interactions.csv

# Data Processing
DATA_VALIDATION_ENABLED=true
DATA_PREPROCESSING_ENABLED=true
DATA_FEATURE_ENGINEERING=true

# ================================
# DEPLOYMENT CONFIGURATION
# ================================

# Container Settings
CONTAINER_MEMORY_LIMIT=2G
CONTAINER_CPU_LIMIT=1.0

# Kubernetes Settings (if deploying to k8s)
K8S_NAMESPACE=surg
K8S_REPLICAS=3
K8S_RESOURCE_REQUESTS_CPU=200m
K8S_RESOURCE_REQUESTS_MEMORY=512Mi

# ================================
# BUSINESS RULES
# ================================

# Content Filtering
ENABLE_CONTENT_FILTERING=true
BLOCKED_CATEGORIES=adult,violence
MIN_RATING_THRESHOLD=3.0

# Price Filters
ENABLE_PRICE_FILTERING=false
MAX_PRICE_RATIO=2.0

# Diversity Requirements
ENFORCE_CATEGORY_DIVERSITY=true
MAX_SAME_CATEGORY_RATIO=0.5

# ================================
# EXPERIMENTAL FEATURES
# ================================

# A/B Testing
AB_TESTING_ENABLED=false
AB_TESTING_TRAFFIC_SPLIT=0.1

# Advanced Algorithms
EXPERIMENTAL_ALGORITHMS=false
NEURAL_COLLABORATIVE_FILTERING=false
GRAPH_NEURAL_NETWORKS=false

# Real-time Personalization
REAL_TIME_USER_MODELING=false
CONTEXTUAL_BANDITS=false