# SURG Environment Configuration
# Copy this file to .env and customize for your environment

# GenAI Configuration (OpenAI)
GENAI_API_KEY=your-openai-api-key-here
GENAI_API_BASE=https://api.openai.com/v1
GENAI_ORGANIZATION=your-organization-id
GENAI_MODEL=gpt-3.5-turbo
GENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Database Configuration
SURG_DATABASE_BACKEND=sqlite
SURG_DATABASE_CONNECTION_STRING=sqlite:///surg.db
# For PostgreSQL:
# SURG_DATABASE_BACKEND=postgresql
# SURG_DATABASE_HOST=localhost
# SURG_DATABASE_PORT=5432
# SURG_DATABASE_NAME=surg
# SURG_DATABASE_USERNAME=surg_user
# SURG_DATABASE_PASSWORD=surg_password

# Cache Configuration
SURG_CACHE_ENABLED=true
SURG_CACHE_BACKEND=memory
# For Redis:
# SURG_CACHE_BACKEND=redis
# SURG_CACHE_REDIS_URL=redis://localhost:6379/0

# Model Configuration
SURG_MODEL_EMBEDDING_DIMENSIONS=768
SURG_MODEL_MAX_CANDIDATES=1000
SURG_MODEL_LEARNING_RATE=0.001
SURG_MODEL_BATCH_SIZE=256

# System Configuration
SURG_DEBUG=false
SURG_RANDOM_SEED=42
SURG_DATA_DIR=./data
SURG_MODEL_DIR=./models
SURG_CACHE_DIR=./cache

# Logging Configuration
SURG_LOGGING_LEVEL=INFO
SURG_LOGGING_FILE_PATH=./logs/surg.log